# Normalize line endings to LF across the repo to avoid CRLF/LF churn
# (especially on WSL-mounted Windows checkouts).
* text=auto eol=lf

# Treat known binary assets as binary so they are never line-ending mangled.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
